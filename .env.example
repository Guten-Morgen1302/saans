# Copy to .env for local runs (python scripts/run_local.py). Never commit .env.
# On AWS the three secrets come from SSM Parameter Store instead (T10).
OPENAQ_API_KEY=
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=            # free at aistudio.google.com; blank = no AI summary

# Telegram ids (numbers; channels/groups start with -100...)
SAANS_PRINCIPAL_USER_ID=
SAANS_ADMIN_USER_IDS=
SAANS_PARENT_CHANNEL_ID=
SAANS_STAFF_GROUP_ID=
SAANS_DEMO_PARENT_CHANNEL_ID=
SAANS_DEMO_STAFF_GROUP_ID=
